{
  "name": "feega",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "dev:5173": "lsof -ti tcp:5173 | xargs kill -9 2>/dev/null; vite dev --strictPort",
    "dev:stable": "NO_HMR=1 vite dev",
    "dev:vercel": "vercel dev --listen 5173",
    "build": "node scripts/typecheck-runtime.mjs && vite build",
    "build:node": "NODE_OPTIONS=${NODE_OPTIONS:---max-old-space-size=8192} DEPLOY_TARGET=node npm run build",
    "start": "node --env-file-if-exists=.env build",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:runtime": "node scripts/typecheck-runtime.mjs",
    "release": "node scripts/release.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "import:anomalia-talents": "vite-node --config scripts/vite-node.config.ts scripts/import-anomalia-talents.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "test:realtime-policies": "node scripts/realtime-policy-harness.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/db-seed.mjs",
    "oss:export": "node scripts/export-oss.mjs",
    "postinstall": "patch-package",
    "test:constraints": "node scripts/constraint-harness.mjs",
    "test:storage-policies": "node scripts/storage-policy-harness.mjs",
    "test:privileges": "node scripts/privilege-harness.mjs",
    "db:types": "supabase gen types typescript --project-id klnswzhhgrqvbfjzioul > src/lib/database.types.ts",
    "eval:canvas": "vite-node --config scripts/vite-node.config.ts scripts/eval/canvas.ts",
    "eval:image-node": "vite-node --config scripts/vite-node.config.ts scripts/eval/image-node.ts",
    "eval:gen-node": "vite-node --config scripts/vite-node.config.ts scripts/eval/gen-node.ts",
    "eval:bootstrap": "vite-node --config scripts/vite-node.config.ts scripts/eval/bootstrap.ts",
    "docs:mcp-tools": "node scripts/mcp-inventory.mjs --write"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.21.0",
    "@playwright/test": "^1.49.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-vercel": "^5.5.0",
    "@sveltejs/kit": "^2.31.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.9.0",
    "@types/turndown": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.12",
    "patch-package": "^8.0.1",
    "svelte": "^5.2.7",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.47",
    "@google/genai": "^2.7.0",
    "@microsoft/clarity": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "@seline-analytics/node": "^1.0.1",
    "@sentry/sveltekit": "^10",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "@vercel/sandbox": "^3.0.1",
    "@xyflow/svelte": "^1.6.6",
    "ai": "^7.0.77",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "marked": "^18.0.5",
    "markitdown-ts": "^0.0.10",
    "pg": "^8.13.1",
    "sharp": "^0.35.3",
    "simple-icons": "^16.22.0",
    "stripe": "^22.6.1",
    "svelte-i18n": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.6.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  }
}
