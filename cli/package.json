{
  "name": "feega-cli",
  "version": "0.1.0",
  "description": "Command-line client for feega — the social media AI autopilot.",
  "license": "Apache-2.0",
  "author": "Andrea Buttarelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreabuttarelli/dazero.git",
    "directory": "cli"
  },
  "homepage": "https://feega.app",
  "bugs": {
    "url": "https://github.com/andreabuttarelli/dazero/issues"
  },
  "type": "module",
  "bin": {
    "feega": "./cli.ts",
    "feega-mcp": "./mcp/stdio.ts"
  },
  "keywords": [
    "feega",
    "cli",
    "social-media",
    "mcp",
    "content",
    "seo"
  ],
  "scripts": {
    "dev": "bun run cli.ts",
    "mcp": "bun run mcp/stdio.ts",
    "mcp:http": "bun run mcp/http.ts",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "build:npm": "bun run scripts/build-npm.ts",
    "vercel-build": "node scripts/build-vercel.mjs",
    "sync:contracts": "bash scripts/sync-contracts.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/node": "^10.69.0",
    "@supabase/supabase-js": "^2.46.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "esbuild": "^0.28.2",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@vercel/node": "^5.9.7",
    "typescript": "5.8.3"
  }
}
